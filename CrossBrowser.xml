<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="CrossBrowserSuite">

 <!-- Edge Execution (2 Test Cases) -->
  <test thread-count="5" name="EdgeTest">
     <parameter name="BROWSER" value="edge"></parameter>
    <parameter name="URL" value="https://www.saucedemo.com/"></parameter>
    <parameter name="USERNAME" value="standard_user"></parameter>
    <parameter name="PASSWORD" value="secret_sauce"></parameter>
    <classes>
      <class name="Smoke_RegressionTest.AddProdToCartTest"></class>
      <class name="Smoke_RegressionTest.LockedUserLoginTest"></class>
    </classes>
  </test> <!-- Test -->
  
   <!-- Firefox Execution (3 Test Cases) -->
  
  <test thread-count="5" name="FireFoxTest">
     <parameter name="BROWSER" value="firefox"></parameter>
    <parameter name="URL" value="https://www.saucedemo.com/"></parameter>
    <parameter name="USERNAME" value="standard_user"></parameter>
    <parameter name="PASSWORD" value="secret_sauce"></parameter>
    <classes>
      <class name="Smoke_RegressionTest.HandlingDropDownLowProdTest"></class>
      <class name="Smoke_RegressionTest.HandlingDropdownZtoATest"></class>
      <class name="Smoke_RegressionTest.MultipleProductsAddToCartTest"></class>
    </classes>
  </test> <!-- Test -->
  
  
  
  
</suite> <!-- Suite -->
