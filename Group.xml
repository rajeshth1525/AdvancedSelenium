<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="GroupSuite">
  <test thread-count="5" name="SmokeAndRegressionGroupTest">
     <groups>
        <run>
          <include name="smoke"></include>
          <include name="regression"></include>
        </run>  
     </groups>
     
    <classes>
      <class name="BatchSuiteTest.AddProdToCartTest"></class>
      <class name="BatchSuiteTest.LockedUserLoginTest"></class>
      <class name="BatchSuiteTest.HandlingDropDownLowProdTest"></class>
      <class name="BatchSuiteTest.HandlingDropdownZtoATest"></class>
      <class name="BatchSuiteTest.MultipleProductsAddToCartTest"></class> 
    </classes>
  </test> <!-- Test -->
</suite> <!-- Suite -->
